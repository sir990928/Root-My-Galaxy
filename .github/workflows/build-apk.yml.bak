name: Galaxy-Su 自动瘦身构建
on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  TARGET: Galaxy-Su
  RAW_APK: app/build/outputs/apk/release/app-release.apk
  TEMP_DIR: temp_apk_work
  UNSIGNED_TMP: temp-noalign.apk
  ALIGNED_TMP: temp-aligned.apk

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取源码
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 配置JDK21
        uses: actions/setup-java@v4
        with:
          java-version: "21"
          distribution: temurin
          cache: gradle

      # 第一步：先还原密钥文件，提前生成release.jks
      - name: 还原签名密钥文件
        env:
          KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE }}
        run: echo "$KEYSTORE_BASE64" | base64 -d > release.jks

      - name: 安装全套工具链
        run: sudo apt update && sudo apt install -y zip unzip binutils-aarch64-linux-gnu zipalign apksigner

      - name: 安装Android SDK
        uses: android-actions/setup-android@v3

      # Gradle构建【未签名】包，不再校验签名密码，不会抛缺失异常
      - name: Gradle构建无签名Release包
        run: ./gradlew assembleRelease --no-daemon --stacktrace

      # 解压、删除旧签名、批量strip全部so（包含conscrypt）
      - name: 批量压缩所有原生库
        run: |
          rm -rf ${{ env.TEMP_DIR }}
          mkdir ${{ env.TEMP_DIR }}
          cd ${{ env.TEMP_DIR }}
          unzip -q ../${{ env.RAW_APK }}
          rm -rf META-INF
          aarch64-linux-gnu-strip --strip-all lib/arm64-v8a/*.so
          zip -r -q -0 ../${{ env.UNSIGNED_TMP }} .
          cd ..

      # 4字节对齐
      - name: Zipalign对齐
        run: zipalign -p -f 4 ${{ env.UNSIGNED_TMP }} ${{ env.ALIGNED_TMP }}

      # 统一apksigner签名，直接读取secrets，不再依赖gradle环境变量
      - name: Apksigner 完整签名
        run: |
          apksigner sign \
            --ks release.jks \
            --ks-pass pass:${{ secrets.SIGNING_KEYSTORE_PASSWORD }} \
            --key-pass pass:${{ secrets.SIGNING_KEY_PASSWORD }} \
            --ks-key-alias ${{ secrets.SIGNING_KEY_ALIAS }} \
            --out ${{ env.RAW_APK }} \
            ${{ env.ALIGNED_TMP }}

      # 清理临时文件
      - name: 清理缓存文件
        run: rm -rf ${{ env.TEMP_DIR }} ${{ env.UNSIGNED_TMP }} ${{ env.ALIGNED_TMP }} release.jks

      - name: 上传成品APK
        uses: actions/upload-artifact@v4
        with:
          name: App-${{ env.TARGET }}
          retention-days: 30
          path: ${{ env.RAW_APK }}
