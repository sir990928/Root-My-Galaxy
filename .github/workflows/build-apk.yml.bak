name: Galaxy-Su 构建发布
on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  APK_DIR: ${{ github.workspace }}/app/build/outputs/apk/release
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取源码
        uses: actions/checkout@v4

      - name: 配置JDK21
        uses: actions/setup-java@v4
        with:
          java-version: "21"
          distribution: temurin
          cache: gradle

      - name: 生成密钥文件
        env:
          KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE }}
        run: echo "$KEYSTORE_BASE64" | base64 -d > release.jks

      - name: 安装Android SDK工具
        uses: android-actions/setup-android@v3

      # 编译无签名Release包
      - name: Gradle编译
        run: ./gradlew assembleRelease --no-daemon --stacktrace

      # 自动找到编译输出apk
      - name: 获取APK路径
        run: |
          ls ${{ env.APK_DIR }}
          APK=$(ls ${{ env.APK_DIR }}/*.apk | head -n1)
          echo "APK=$APK" >> $GITHUB_ENV

      # 直接对原始编译好的apk签名，不解压、不修改库文件
      - name: 签名APK
        run: |
          apksigner sign \
            --ks release.jks \
            --ks-pass pass:${{ secrets.SIGNING_KEYSTORE_PASSWORD }} \
            --key-pass pass:${{ secrets.SIGNING_KEY_PASSWORD }} \
            --ks-key-alias ${{ secrets.SIGNING_KEY_ALIAS }} \
            ${{ env.APK }}

      # 上传成品
      - name: 导出APK
        uses: actions/upload-artifact@v4
        with:
          name: Root-My-Galaxy-Release
          path: ${{ env.APK }}

      # 清理密钥
      - name: 清理文件
        run: rm -f release.jks
