name: Build Root-My-Galaxy Release APK
on:
  push:
    branches: [ main ]
  workflow_dispatch:

env:
  SDK_ROOT: ${{ github.workspace }}/android-sdk
  BUILD_TOOLS_VERSION: "35.0.0"
  APK_OUT_DIR: ${{ github.workspace }}/app/build/outputs/apk/release

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Setup JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: "21"
          distribution: temurin
          cache: gradle

      - name: Write keystore file from secret
        env:
          KS_BASE64: ${{ secrets.SIGNING_KEYSTORE }}
        run: echo "$KS_BASE64" | base64 -d > release.jks

      # 修复后的SDK安装脚本，路径层级完全修正
      - name: Install Android Cmdline Tools & Build Tools
        run: |
          sudo apt update && sudo apt install unzip -y
          mkdir -p $SDK_ROOT/cmdline-tools
          cd $SDK_ROOT/cmdline-tools
          wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip
          # 关键修复：解压内容直接丢到latest，不嵌套双层目录
          unzip -q commandlinetools-linux-11076708_latest.zip
          mv cmdline-tools latest
          rm -rf commandlinetools-linux-11076708_latest.zip
          # 当前脚本会话立刻加载PATH
          export PATH=$SDK_ROOT/cmdline-tools/latest/bin:$PATH
          # 持久化PATH给后续所有步骤
          echo "PATH=$SDK_ROOT/cmdline-tools/latest/bin:$PATH" >> $GITHUB_ENV
          # 同意SDK协议
          yes | sdkmanager --sdk_root=$SDK_ROOT --licenses
          yes | sdkmanager --sdk_root=$SDK_ROOT "build-tools;$BUILD_TOOLS_VERSION"
          echo "APKSIGNER=$SDK_ROOT/build-tools/$BUILD_TOOLS_VERSION/apksigner" >> $GITHUB_ENV

      - name: Build unsigned release apk
        run: ./gradlew assembleRelease --no-daemon --stacktrace

      - name: Sign APK with apksigner
        env:
          KS_PWD: ${{ secrets.SIGNING_KEYSTORE_PASSWORD }}
          KEY_PWD: ${{ secrets.SIGNING_KEY_PASSWORD }}
          KEY_ALIAS: ${{ secrets.SIGNING_KEY_ALIAS }}
        run: |
          APK=$(ls $APK_OUT_DIR/*.apk | head -1)
          ${{ env.APKSIGNER }} sign \
            --ks release.jks \
            --ks-pass pass:$KS_PWD \
            --key-pass pass:$KEY_PWD \
            --ks-key-alias $KEY_ALIAS \
            "$APK"

      - name: Upload signed APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: Root-My-Galaxy-v12
          path: ${{ env.APK_OUT_DIR }}/*.apk

      - name: Clean secret keystore
        if: always()
        run: rm -f release.jks
