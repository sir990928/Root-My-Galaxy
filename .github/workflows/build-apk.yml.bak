name: Galaxy-Su 自动瘦身构建
on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  TARGET: Galaxy-Su
  # 使用绝对路径，杜绝../相对路径出错
  APK_DIR: ${{ github.workspace }}/app/build/outputs/apk/release
  RAW_APK: ${{ github.workspace }}/app/build/outputs/apk/release/app-release.apk
  TEMP_DIR: ${{ github.workspace }}/temp_apk_work
  UNSIGNED_TMP: ${{ github.workspace }}/temp-noalign.apk
  ALIGNED_TMP: ${{ github.workspace }}/temp-aligned.apk

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取源码
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 配置JDK21
        uses: actions/setup-java@v4
        with:
          java-version: "21"
          distribution: temurin
          cache: gradle

      # 提前还原密钥文件
      - name: 还原签名密钥
        env:
          KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE }}
        run: echo "$KEYSTORE_BASE64" | base64 -d > release.jks

      # 安装工具
      - name: 安装打包工具链
        run: sudo apt update && sudo apt install -y zip unzip binutils-aarch64-linux-gnu zipalign apksigner

      - name: 安装Android SDK
        uses: android-actions/setup-android@v3

      # Gradle 构建无签名包
      - name: Gradle 编译Release
        run: ./gradlew assembleRelease --no-daemon --stacktrace

      # 新增：校验APK是否生成，不存在直接终止流程
      - name: 校验构建输出包
        run: |
          if [ ! -f ${{ env.RAW_APK }} ]; then
            echo "错误：构建未生成app-release.apk"
            exit 1
          fi
          ls -la ${{ env.APK_DIR }}

      # 解压+strip全部so
      - name: 批量压缩原生库
        run: |
          rm -rf ${{ env.TEMP_DIR }}
          mkdir ${{ env.TEMP_DIR }}
          cd ${{ env.TEMP_DIR }}
          unzip -q ${{ env.RAW_APK }}
          rm -rf META-INF
          aarch64-linux-gnu-strip --strip-all lib/arm64-v8a/*.so
          zip -r -q -0 ${{ env.UNSIGNED_TMP }} .
          cd ..

      # 4字节对齐
      - name: Zipalign 对齐APK
        run: zipalign -p -f 4 ${{ env.UNSIGNED_TMP }} ${{ env.ALIGNED_TMP }}

      # 签名
      - name: Apksigner 签名成品包
        run: |
          apksigner sign \
            --ks release.jks \
            --ks-pass pass:${{ secrets.SIGNING_KEYSTORE_PASSWORD }} \
            --key-pass pass:${{ secrets.SIGNING_KEY_PASSWORD }} \
            --ks-key-alias ${{ secrets.SIGNING_KEY_ALIAS }} \
            --out ${{ env.RAW_APK }} \
            ${{ env.ALIGNED_TMP }}

      # 清理临时文件
      - name: 清理缓存
        run: rm -rf ${{ env.TEMP_DIR }} ${{ env.UNSIGNED_TMP }} ${{ env.ALIGNED_TMP }} release.jks

      # 上传成品
      - name: 上传APK
        uses: actions/upload-artifact@v4
        with:
          name: App-${{ env.TARGET }}
          retention-days: 30
          path: ${{ env.RAW_APK }}
